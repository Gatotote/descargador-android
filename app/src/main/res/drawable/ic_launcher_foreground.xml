<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Mismo emblema que la app de escritorio: aro fino + flecha de descarga /
         flecha de conversión + bandeja, en azul. Dentro de la zona segura. -->
    <group android:name="emblema">
        <!-- Aro -->
        <path
            android:strokeColor="#2F6BDF"
            android:strokeWidth="4.2"
            android:fillColor="#00000000"
            android:pathData="M54,24 a30,30 0 1 1 -0.01,0 Z" />
        <!-- Flecha hacia abajo (descargar) -->
        <path
            android:strokeColor="#2F6BDF"
            android:strokeWidth="4.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M44,38 L44,64 M37,57 L44,64 L51,57" />
        <!-- Flecha hacia arriba (convertir) -->
        <path
            android:strokeColor="#2F6BDF"
            android:strokeWidth="4.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M64,64 L64,38 M57,45 L64,38 L71,45" />
        <!-- Bandeja -->
        <path
            android:strokeColor="#2F6BDF"
            android:strokeWidth="4.2"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M41,71 L67,71" />
    </group>
</vector>
