# Copia este archivo a  keystore.properties  y rellena con TU clave de firma.
# Si no existe keystore.properties, el build de release se firma con la clave
# de depuración automáticamente (suficiente para instalar por USB / sideload).

storeFile=mi-clave.jks
storePassword=CAMBIA_ESTO
keyAlias=CAMBIA_ESTO
keyPassword=CAMBIA_ESTO
